# =====================================================================
# SPINEL DISTRIBUTION - ENVIRONMENT CONFIGURATION
# =====================================================================

# GEMINI_API_KEY: Required for Gemini AI assistant calls
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""

# Administration Credentials
ADMIN_TECHNICAL_EMAIL="admin@spineldistribution.com"
ADMIN_ACCESS_KEY="SPINEL_SECURE_ACCESS_2026_KEY"

# Currency Exchange Configuration (USD to NGN rate)
USD_TO_NGN_EXCHANGE_RATE="1580"

# Supabase Storage & Authentication (Optional)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Paystack Payment Gateway (Optional)
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# =====================================================================
# cPanel MySQL / MariaDB Database Configuration
# Connects Request Quote (RFQ) submissions directly to your cPanel database
# =====================================================================
# TIP FOR CPANEL: Set DB_HOST="127.0.0.1" (avoids Linux Unix-socket mismatches)
DB_HOST="127.0.0.1"
DB_USER="cpanelusername_dbuser"
DB_PASSWORD="your_database_password"
DB_NAME="cpanelusername_dbname"
DB_PORT="3306"
