# =====================================================================
# SPINEL DISTRIBUTION - ENVIRONMENT CONFIGURATION FOR CPANEL
# =====================================================================

# Administration Credentials
ADMIN_TECHNICAL_EMAIL="admin@spineldistribution.com"
ADMIN_ACCESS_KEY="SPINEL_SECURE_ACCESS_2026_KEY"

# Currency Exchange Configuration (USD to NGN rate)
USD_TO_NGN_EXCHANGE_RATE="1580"

# =====================================================================
# cPanel MySQL / MariaDB Database Configuration
# Connects Users table and Request Quote (RFQ) submissions to cPanel
# =====================================================================
# TIP FOR CPANEL: Set DB_HOST="127.0.0.1" (avoids Linux Unix-socket mismatches)
DB_HOST="127.0.0.1"
DB_USER="cpanelusername_dbuser"
DB_PASSWORD="your_database_password"
DB_NAME="cpanelusername_dbname"
DB_PORT="3306"

# =====================================================================
# cPanel Email & SMTP Configuration for 6-Digit OTP Delivery
# Use your cPanel Webmail account (e.g. info@yourdomain.com) or external SMTP
# =====================================================================
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT="465"
SMTP_USER="info@yourdomain.com"
SMTP_PASSWORD="your_cpanel_email_password"
SMTP_FROM="\"Spinel Distribution\" <info@yourdomain.com>"
