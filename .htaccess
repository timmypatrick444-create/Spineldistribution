# =====================================================================
# Spinel Distribution - cPanel Production Web Server Configuration
# =====================================================================

# 1. Force HTTPS Redirection (Eliminates HTTP 426 "Upgrade Required")
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Browser & Proxy Caching Controls
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 3. Phusion Passenger Configuration
<IfModule mod_passenger.c>
  PassengerAppType node
  PassengerStartupFile app.js
</IfModule>
