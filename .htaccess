# =====================================================================
# Spinel Distribution - cPanel Production Web Server Configuration
# =====================================================================

# 1. Force HTTPS Redirection (Eliminates HTTP 426 "Upgrade Required")
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Prevent Caching of HTML (Ensures live domain always shows newest version)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
    Header set Pragma "no-cache"
    Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    Header unset ETag
    Header unset Last-Modified
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 3. Phusion Passenger Configuration
<IfModule mod_passenger.c>
  PassengerAppType node
  PassengerStartupFile app.js
  PassengerEnabled on
  PassengerRestartDir tmp
</IfModule>
